+
+#define EDGE5X0_BB_SMB0 ((1<<8) | (1<<9))
+#define EDGE5X0_BB_SMB1 ((1<<11) | (1<<12))
+#define EDGE5X0_BB_SMB2 ((1<<13) | (1<<14))
+
