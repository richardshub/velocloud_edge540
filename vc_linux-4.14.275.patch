+static s32 igb_vc_mdiobb_read(struct e1000_hw *hw, u32 reg, u16 *data){
+	s32 ret = -ENODEV;
+
+	// read the register;
+
+	if( !vc_mdio_bus)
+		return(ret);
+	ret = mdiobus_read(vc_mdio_bus, hw->phy.addr, reg);
+	vcdbg("%d/%d = 0x%x\n", 0, reg, ret);
+	if(ret < 0)
+		return(ret);
+	*data = ret;
+	return(0);
+}
