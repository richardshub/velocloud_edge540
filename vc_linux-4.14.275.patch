+static int vc_request_gpio_i2c_reset(unsigned gpio){
+	int ret;
+
+	ret = gpio_request_one(gpio, GPIOF_OUT_INIT_LOW, "i2c-reset");
+	if (!ret){
+		vc_i2c_gpio_reset(gpio);
