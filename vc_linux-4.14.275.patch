+// create low-pulse on i2c ctrl reset pin;
+// keep BLINK input low;
+static void vc_i2c_gpio_reset(unsigned gpio){
+	gpio_set_value(gpio, 0);
+	usleep_range(1000, 2000);
+	gpio_set_value(gpio, 1);
+}
