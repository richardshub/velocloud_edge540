+static ssize_t show_vc_5x0_fan_rpm(struct device *dev, struct device_attribute *attr, char *buf){
+	int reg_val, tach_reading;
+	vc_data_t *vcd = &vc_data;
+	struct i2c_client *client = vcd->i2c.client[VC_I2C_4];
+
+        reg_val = vc_read_byte(client, EMC2104_FAN1_TACH_READ_HI);
+        if (reg_val < 0){
+                return (reg_val);
+	}
+	if (reg_val == 0xff){
+		reg_val = 0;
+	}
+	tach_reading = (reg_val << 8);
+        
+	reg_val = vc_read_byte(client, EMC2104_FAN1_TACH_READ_LO);
+        if (reg_val < 0){
+                return (reg_val);
+	}
+	if (reg_val == 0xf8){
+		reg_val = 0;
+	}
+	tach_reading |= reg_val;
+
+	/* Three LSB are insignificant for measurement. */
+	tach_reading >>= 3;
+
+	if (tach_reading == 0){
+        	return sprintf(buf, "%d\n", 0);
+	}
+        return sprintf(buf, "%d\n", EMC2104_VELOCLOUD_FAN_MULTI / tach_reading);
+}
+
+static ssize_t set_vc_5x0_fan_manual(struct device *dev,struct device_attribute *attr, const char *buf, size_t size){
+	int rv;
+	unsigned long val;
+	vc_data_t *vcd = &vc_data;
+	struct i2c_client *client = vcd->i2c.client[VC_I2C_4];
+
+	rv = kstrtoul(buf, 10, &val);
+	if (rv){
+		return rv;
+	}
+	rv = vc_read_byte(client, EMC2104_FAN1_LUT_OFFSET);
+	if (rv < 0){
+		return (rv);
+	}
+	/* XXX Fixme: Enabling direct setting mode should not be difficult, however,
+	 * it proves to be a little tricky.  I need to understand the datasheet a little
+	 * more I suspect to figure out how to correctly enable that mode, but the following
+	 * order seems to work for now: Enable Direct Setting Mode for direct fan control. 
+	 */
+	if (val > 0) {
+
+		rv |= (LUT_LOCK | TACH_DRIVE);
+		vc_write_byte(client, EMC2104_FAN1_LUT_OFFSET, rv);
+
+		mdelay(50);
+
+		rv &= ~(TACH_DRIVE | LUT_LOCK);
+		vc_write_byte(client, EMC2104_FAN1_LUT_OFFSET, rv);
+
+		mdelay(50);
+
+		rv |= (LUT_LOCK | TACH_DRIVE);
+		vc_write_byte(client, EMC2104_FAN1_LUT_OFFSET, rv);
+
+		mdelay(50);
+
+		rv &= ~(TACH_DRIVE | LUT_LOCK);
+		vc_write_byte(client, EMC2104_FAN1_LUT_OFFSET, rv);
+
+	} else if (val == 0) {
+		rv |= LUT_LOCK;
+		vc_write_byte(client, EMC2104_FAN1_LUT_OFFSET, rv);
+	}
+
+	return size;
+}
+
+static ssize_t show_vc_5x0_fan_manual(struct device *dev, struct device_attribute *attr, char *buf){
+	int err, val;
+	vc_data_t *vcd = &vc_data;
+	struct i2c_client *client = vcd->i2c.client[VC_I2C_4];
+	
+	err = vc_read_byte(client, EMC2104_FAN1_LUT_OFFSET);
+	if (err < 0){
+		return (err);
+	}
+	if (err & (LUT_LOCK | TACH_DRIVE)){
+		val = 1;
+	}
+	else
+	{
+		val = 0;
+	}
+
+       	return sprintf(buf, "%d\n", val);
+}
+
+static DEVICE_ATTR(fan_manual, S_IRUGO | S_IWUSR, show_vc_5x0_fan_manual, set_vc_5x0_fan_manual);
+
+static ssize_t set_vc_5x0_fan_manual_speed(struct device *dev,struct device_attribute *attr, const char *buf, size_t size){
+	int err;
+	unsigned long fan_rpm, pwm;
+	vc_data_t *vcd = &vc_data;
+	struct i2c_client *client = vcd->i2c.client[VC_I2C_4];
+
+	err = kstrtoul(buf, 10, &fan_rpm);
+	if (err){
+		return err;
+	}
+	if (fan_rpm > EDGE5x0_FAN_RPM_SPEED){
+		return -EINVAL;
+	}
+	/*
+	 * Now that we know the percentage of the full-on RPM speed to set,
+	 * we simply use a ratio to derive the PWM from the desired RPM.
+	 */
+	pwm = (255 * fan_rpm) / EDGE5x0_FAN_RPM_SPEED;
+
+	err = vc_write_byte(client, FAN1_DRIVER_SETTING, pwm);
+	if (err < 0){
+		return(err);
+	}
+
+	return size;
+}
+
+static DEVICE_ATTR(fan_manual_speed, S_IWUSR, NULL, set_vc_5x0_fan_manual_speed);
