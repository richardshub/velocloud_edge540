+	.tag_protocol      = cpu_to_be16(ETH_P_EDSA),
+	.priv_size         = sizeof(struct m88e6176_priv),
+	.probe             = m88e6176_probe,
+	.setup             = m88e6176_setup,
+	.set_addr          = m88e6176_set_addr,
+	.phy_read          = m88e6176_phy_read,
+	.phy_write         = m88e6176_phy_write,
+	.poll_link         = m88e6176_poll_link,
+	.get_strings       = m88e6176_get_strings,
+	.get_ethtool_stats = m88e6176_get_stats,
+	.get_sset_count    = m88e6176_get_sset_count,
+};
+
+// dsa mdio read;
+
+static int
+igb_vc_dsa_read(struct mii_bus *bus, int addr, int reg)
+{
+	struct vc_dsa_priv *priv = bus->priv;
+	struct e1000_hw *hw = priv->hw;
+	int adreg = (addr << 5) | reg;
+	u16 data;
+	int ret;
+
+	if(addr >= REG_DIRECT)
+		ret = igb_vc_mdio_read(hw, adreg, &data);
+	else
+		ret = igb_vc_smi_mdio_read(hw, adreg, &data);
+	//printk("%s: %d phy %d reg %d data 0x%x\n", __func__, ret, addr, reg, data);
+	return(ret? ret : data);
+}
+
+// dsa mdio write;
+
+static int
+igb_vc_dsa_write(struct mii_bus *bus, int addr, int reg, u16 val)
+{
+	struct vc_dsa_priv *priv = bus->priv;
+	struct e1000_hw *hw = priv->hw;
+	int adreg = (addr << 5) | reg;
+	int ret;
+
+	if(addr >= REG_DIRECT)
+		ret = igb_vc_mdio_write(hw, adreg, val);
+	else
+		ret = igb_vc_smi_mdio_write(hw, adreg, val);
+	//printk("%s: %d phy %d reg %d data 0x%x\n", __func__, ret, addr, reg, val);
+	return(ret);
+}
+
+// init dsa interface;
+
+s32
+igb_vc_dsa_init(struct igb_adapter *adapter)
+{
+	struct e1000_hw *hw = &adapter->hw;
+	struct net_device *netdev = adapter->netdev;
+	struct mii_bus *bus;
+	struct vc_dsa_priv *priv;
+	struct platform_device *pdev;
+	struct dsa_platform_data *dpd;
+	struct dsa_chip_data *dcd;
+	s32 ret;
+	int i;
+
+	if( !(dsa & DSA_ENABLE))
+		return(0);
+
+	// get per-platform config;
+
+	switch(hw->vc_id) {
+	case e1000_vc500:
+		dpd = vc_dsa_500[hw->bus.func];
+		break;
+	case e1000_vc5x0:
+		dpd = vc_dsa_5x0[hw->bus.func];
+		break;
+	default:
+		dpd = NULL;
+		break;
+	}
+	if( !dpd)
+		return(0);		// no dsa switch;
+
+	// allocate and register mdio bus;
+
+	bus = mdiobus_alloc_size(sizeof(struct vc_dsa_priv));
+	if( !bus)
+		return(-ENOMEM);
+
+	adapter->mii_dsa = bus;
+	priv = bus->priv;
+	priv->hw = hw;
+
+	pdev = &priv->pdev;
+	pdev->name = VC_DSA;
+	pdev->id = hw->bus.func;
+	pdev->num_resources = 0;
+	pdev->dev.platform_data = dpd;
+
+	bus->name = "mdio-dsa";
+	bus->phy_mask = ~0;
+	bus->irq = priv->irqs;
+	bus->parent = &netdev->dev;
+
+	bus->read = igb_vc_dsa_read;
+	bus->write = igb_vc_dsa_write;
+
+	for(i = 0; i < PHY_MAX_ADDR; i++) {
+		if( !bus->irq[i])
+			bus->irq[i] = PHY_POLL;
+	}
+	snprintf(bus->id, MII_BUS_ID_SIZE, VC_DSA "-sw%d", hw->bus.func);
+
+	ret = mdiobus_register(bus);
+	if(ret < 0)
+		goto fail_mdio_reg;
+
+	// register dsa switch;
+
+	dcd = dpd->chip;
+	dpd->netdev = &netdev->dev;
+	dcd->mii_bus = &bus->dev;
+	ret = platform_device_register(pdev);
+	if(ret < 0)
+		goto fail_dsa_reg;
+
+	return(0);
+
+fail_dsa_reg:
+	mdiobus_unregister(bus);
+fail_mdio_reg:
+	mdiobus_free(bus);
+	return(ret);
+}
+
+// free dsa interface;
+
+void
+igb_vc_dsa_exit(struct igb_adapter *adapter)
+{
+	struct mii_bus *bus = adapter->mii_dsa;
+	struct vc_dsa_priv *priv;
+
+	if( !bus)
+		return;
+
+	priv = bus->priv;
+
+	platform_device_unregister(&priv->pdev);
+
+	mdiobus_unregister(bus);
+	mdiobus_free(bus);
+}
+
+// register dsa switch driver;
+
+void
+igb_vc_dsa_register(void)
+{
+	if(dsa & DSA_ENABLE)
+		register_switch_driver(&m88e6176_switch_driver);
+}
+
+// unregister dsa switch driver;
+
+void
+igb_vc_dsa_unregister(void)
+{
+	if(dsa & DSA_ENABLE)
+		unregister_switch_driver(&m88e6176_switch_driver);
+}
+
