+        VC_I2C_NONE = -1,
+        VC_I2C_0 = 0,
+        VC_I2C_1,
+        N_VC_I2C_DEVS,
+};
+
+enum vc_poe_i2c_ports_idx {
+        VC_I2C_PORT_NONE = -1,
+        VC_I2C_PORT1 = 0,
+        VC_I2C_PORT2,
+        VC_I2C_PORT3,
+        VC_I2C_PORT4,
+        N_VC_I2C_PORTS,
+};
+
+enum vc_poe_i2c_chipset_mode {
+        VC_I2C_CHIPSET_MANUAL_MODE = 0,
+        VC_I2C_CHIPSET_AUTO_MODE,
+};
