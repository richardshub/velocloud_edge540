+static ssize_t
+show_mA(struct port_obj *pobj, struct port_attribute *attr, char *buf)
+{
+        s32 val, lsb, msb;
+	s32 dec, cent;
+        struct i2c_client *client;
+	struct ltc4266_port *port;
+        struct i2c_ltc4266_chipset *chipset;
+
+        if(pobj->index >= N_VC_I2C_PORTS)
+                return(-EINVAL);
+
+        client = to_i2c_client(pobj->dev);
+
+        chipset = (struct i2c_ltc4266_chipset *)i2c_get_clientdata(client);
+	
+	port = &chipset->port_dev[pobj->index];
+
+	mutex_lock(&port->port_lock);
+
+	if ( !(port->last_port_event & (POWER_GOOD_INTERRUPT))) {
+		mutex_unlock(&port->port_lock);
+		return sprintf(buf, "%d.%d%d%d", 0, 0, 0, 0);
+	}
+
+	mutex_unlock(&port->port_lock);
+
+        lsb = i2c_smbus_read_byte_data(chipset->client,
+                        LTC_mA_LSB_BASE_REG+(pobj->index*4));
+
+        msb = i2c_smbus_read_byte_data(chipset->client,
+                        LTC_mA_MSB_BASE_REG+(pobj->index*4));
+
+        val = ((msb << 8) | lsb);
+
+	/* Resolution is 122.07uA/1 LSB. Multiply to 122070nV to do the
+	 * calculation. 
+	 */
+	val = val * 122070;
+
+        /* Convert to V and strip out whole number. */
+        msb = val / (1000 * 1000);
+
+        lsb = val - msb * 1000 * 1000;
+
+        /* This is our resolution. */
+        lsb = lsb / 1000;
+
+        cent = lsb / 100;
+
+        lsb = lsb - cent * 100;
+
+        dec = lsb / 10;
+
+        lsb = lsb - dec * 10;
+
+	/* Resolution only to three decimal places. */
+        return sprintf(buf, "%d.%d%d%d", msb, cent, dec, lsb);
+}
+
+static ssize_t
+show_volts(struct port_obj *pobj, struct port_attribute *attr, char *buf)
+{
+        s32 val, lsb, msb;
+	s32 dec, cent;
+        struct i2c_client *client;
+	struct ltc4266_port *port;
+        struct i2c_ltc4266_chipset *chipset;
+
+        if(pobj->index >= N_VC_I2C_PORTS)
+                return(-EINVAL);
+
+        client = to_i2c_client(pobj->dev);
+
+        chipset = (struct i2c_ltc4266_chipset *)i2c_get_clientdata(client);
+	
+	port = &chipset->port_dev[pobj->index];
+
+	mutex_lock(&port->port_lock);
+
+	if (!(port->last_port_event & (POWER_GOOD_INTERRUPT))) {
+		mutex_unlock(&port->port_lock);
+		return sprintf(buf, "%d.%d%d%d", 0, 0, 0, 0);
+	}
+
+	mutex_unlock(&port->port_lock);
+
+	lsb = i2c_smbus_read_byte_data(chipset->client, 
+		LTC_VOLTS_LSB_BASE_REG+(pobj->index*4));
+
+        msb = i2c_smbus_read_byte_data(chipset->client, 
+		LTC_VOLTS_MSB_BASE_REG+(pobj->index*4));
+
+	val = ((msb << 8) | lsb);
+
+	/* Resolution is 5.835mV/1 LSB. Convert to 5835uV to do the
+	 * calculation. 
+	 */
+	val = val * 5835;
+
+	/* Convert to V and strip out whole number. */
+	msb = val / (1000 * 1000);
+
+	lsb = val - msb * 1000 * 1000;
+	
+	/* This is our resolution. */
+	lsb = lsb / 1000;
+
+	cent = lsb / 100;
+
+	lsb = lsb - cent * 100;
+
+	dec = lsb / 10;
+
+	lsb = lsb - dec * 10;
+
+        return sprintf(buf, "%d.%d%d%d", msb, cent, dec, lsb);
+}
