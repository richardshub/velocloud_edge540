+static ssize_t
+show_power(struct port_obj *pobj, struct port_attribute *attr, char *buf)
+{
+        s32 statpwr;
+	struct i2c_client *client;
+        struct i2c_ltc4266_chipset *chipset;
+
+	if(pobj->index >= N_VC_I2C_PORTS)
+                return(-EINVAL);
+
+        client = to_i2c_client(pobj->dev);
+
+        chipset = (struct i2c_ltc4266_chipset *)i2c_get_clientdata(client);
+
+	statpwr = i2c_smbus_read_byte_data(chipset->client,
+					LTC_STATPWR_REG);
+
+	/* Upper nibble is pwrgd status for port. */
+	statpwr = ((statpwr >> 4) & (1 << pobj->index));
+
+        return scnprintf(buf, PAGE_SIZE, "%s", (statpwr)? "on" : "off");
+}
+
+static ssize_t
+store_power(struct port_obj *pobj, struct port_attribute *attr,
+                                const char *buf, size_t count)
+{
+        s32 detena, statp, err;
+	struct i2c_client *client;
+        struct i2c_ltc4266_chipset *chipset;
+	struct ltc4266_port *port;
+	char *val = strim((char *)buf);
+
+        if(pobj->index >= N_VC_I2C_PORTS)
+                return(-EINVAL);
+
+        client = to_i2c_client(pobj->dev);
+
+        chipset = (struct i2c_ltc4266_chipset *)i2c_get_clientdata(client);
+
+	if (chipset->mode != VC_I2C_CHIPSET_MANUAL_MODE)
+		return -EINVAL;
+
+	port = &chipset->port_dev[pobj->index];
+
+	if (strcmp(val, "on") == 0 || strcmp(val, "1") == 0) {
+
+		mutex_lock(&port->port_lock);
+
+		if ((port->port_event & (DETECT_INTERRUPT|CLASS_INTERRUPT)) &&
+		     (port->port_state != PORT_STATE_MONITOR)) {
+
+			statp = i2c_smbus_read_byte_data(chipset->client,
+                                (LTC_STATP_BASE_REG + pobj->index));
+
+			if (ltc4266_calculate_total_mA(chipset, pobj->index, statp)) {
+				mutex_unlock(&port->port_lock);
+				return -EINVAL;
+			}
+
+			err = ltc4266_port_pwr(chipset, pobj->index, LTC_PWRPB_ON);
+			if (err < 0) {
+                		dev_err(pobj->dev, "port %d pwr on error\n", 
+								pobj->index);
+			}
+			port->last_port_event = POWER_VTRANS_INTERRUPT;
+			port->port_state = PORT_STATE_MONITOR;
+
+		} else {
+			if (port->port_state == PORT_STATE_MONITOR) {
+				err = -EINVAL;
+				dev_err(pobj->dev, "Device already powered on "
+						"port %d\n", pobj->index);
+			} else {
+				err = -ENODEV;
+				dev_err(pobj->dev, "No device detected on "
+						"port %d\n", pobj->index);
+			}
+		}
+		mutex_unlock(&port->port_lock);
+	
+	} else if (strcmp(val, "off") == 0 || strcmp(val, "0") == 0) {
+
+		mutex_lock(&port->port_lock);
+		if (port->port_state != PORT_STATE_MONITOR) {
+			mutex_unlock(&port->port_lock);
+                	dev_err(pobj->dev, "Invald operation on port %d\n", pobj->index);
+			return -ENODEV;
+		}
+	
+		err = ltc4266_port_pwr(chipset, pobj->index, LTC_PWRPB_OFF);
+		if (err < 0) {
+                	dev_err(pobj->dev, "port %d pwr off error\n", pobj->index);
+		}
+
+		msleep(15);
+
+		detena = ltc4266_detena_port(pobj->index, 0);
+
+                ltc4266_enable_detect_classify(chipset, detena);
+		
+		mutex_lock(&chipset->glbl_lock);
+
+               	chipset->total_mA_avail += port->device_mA;
+
+		mutex_unlock(&chipset->glbl_lock);	
+
+                port->port_state = PORT_STATE_CLASSIFY;
+
+		port->port_event &= ~(DETECT_INTERRUPT|CLASS_INTERRUPT);
+		
+		port->last_port_event = POWER_OFF_INTERRUPT;
+		port->device_mA = 0;
+
+		mutex_unlock(&port->port_lock);
+
+		mutex_lock(&chipset->glbl_lock);	
+		send_eventfd_signal(chipset, pobj->index);
+		mutex_unlock(&chipset->glbl_lock);	
+		
+		dev_dbg(&chipset->client->dev,
+                        "Port %d event detected\n", pobj->index);
+	} else {
+                dev_err(pobj->dev, "vc-poe: bad value: %s\n", buf);
+		err = -EINVAL;
+	}
+
+        if(err < 0)
+                return (err);
+
+        return(count);
+}
