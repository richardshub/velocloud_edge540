+	m88e6176_get_n_stats(ds, ARRAY_SIZE(m88e6176_hw_stats), m88e6176_hw_stats, 5, p5);
+	m88e6176_get_n_stats(ds, ARRAY_SIZE(m88e6176_hw_stats), m88e6176_hw_stats, 6, p6);
+	for(sp = m88e6176_hw_stats, n = 0; n < ARRAY_SIZE(m88e6176_hw_stats); n++, sp++)
+		pr_info("ports %s %lu %lu\n", sp->string, p5[n], p6[n]);
+}
