+	{0x80, 0x07}, /* CLASS 2 LIM=425mA; CUT=131.25mA (55V * .131A) = ~7w  */
+	{0x80, 0x0f}, /* CLASS 3 LIM=425mA; CUT=281mA  (55V * .281A) = ~15.4w */
